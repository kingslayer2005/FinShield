{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "Throughput (events/sec)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(finshield_events_total[1m])",
          "legendFormat": "events/sec"
        }
      ]
    },
    {
      "title": "Flag Rate Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(finshield_flagged_total[5m]) / rate(finshield_events_total[5m])",
          "legendFormat": "flag rate"
        }
      ]
    },
    {
      "title": "Score Distribution",
      "type": "histogram",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "finshield_score_histogram_bucket",
          "legendFormat": "{{le}}"
        }
      ]
    },
    {
      "title": "P95 Latency (ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(finshield_latency_seconds_bucket[5m])) * 1000",
          "legendFormat": "p95 latency (ms)"
        }
      ]
    },
    {
      "title": "Recent Alerts",
      "type": "table",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "datasource": "PostgreSQL",
      "targets": [
        {
          "rawSql": "SELECT transaction_id, score, decision, latency_ms, created_at FROM predictions WHERE decision IN ('review', 'block') ORDER BY created_at DESC LIMIT 20",
          "format": "table"
        }
      ]
    },
    {
      "title": "Drift Status",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 24 },
      "datasource": "PostgreSQL",
      "targets": [
        {
          "rawSql": "SELECT drift_detected::text as value FROM drift_reports ORDER BY created_at DESC LIMIT 1",
          "format": "table"
        }
      ]
    }
  ],
